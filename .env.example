# ===== Server =====
PORT=3010
NODE_ENV=production

# ===== Baza (klinika MySQL bazasi) =====
# Tavsiya: klinika serveridan VPS ga teskari SSH tunel ochiladi
# (klinika serverida: autossh -N -R 3307:127.0.0.1:3306 integrator@goldenvodiyclinic.uz)
# shunda bu yerda DB_HOST=127.0.0.1, DB_PORT=3307 bo'ladi.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_DATABASE=klinika_goldenvodiy

# ===== Telegram bot =====
BOT_TOKEN=

# Onlayn navbat slotlari
BOT_QUEUE_START=09:00
BOT_QUEUE_END=17:00
BOT_QUEUE_INTERVAL_MIN=30
# Bron qilingach to'lov uchun beriladigan vaqt (daqiqa)
BOT_PAY_TIMEOUT_MIN=15

# ===== Payme Merchant API (kassa) =====
# Kassa ochilgach Payme beradigan qiymatlar:
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
# Test kassada sinash uchun: https://checkout.test.paycom.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Telegram Payments provider token (BotFather -> Payments) - zaxira usul
PAYME_PROVIDER_TOKEN=
# Fiskal ma'lumotlar (tasnif.soliq.uz)
PAYME_MXIK_CODE=
PAYME_PACKAGE_CODE=
PAYME_VAT_PERCENT=0
